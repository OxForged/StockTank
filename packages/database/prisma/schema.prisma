// StockTank core schema: Milestone 1 (identity, RBAC, system) plus the content-graph foundation (§6–9).
// Later milestones add media assets, AI, ads, distribution and analytics models.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Identity & access ─────────────────────────

enum UserStatus {
  active
  suspended
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String?    @map("password_hash")
  status       UserStatus @default(active)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  profile   Profile?
  roles     UserRole[]
  sessions  Session[]
  auditLogs AuditLog[]
  apiKeys   ApiKey[]
  follows   Follow[]
  bookmarks Bookmark[]
  host      Host?

  @@map("users")
}

model Profile {
  userId        String   @id @map("user_id")
  displayName   String   @map("display_name")
  avatarUrl     String?  @map("avatar_url")
  bio           String?
  /// Optional public wallet address. Private keys are never stored.
  walletAddress String?  @unique @map("wallet_address")
  locale        String   @default("en")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  grantedAt DateTime @default(now()) @map("granted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Server-side sessions. Only a SHA-256 hash of the session token is stored.
model Session {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// API keys: only a hash and a short display prefix are stored.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  name       String
  prefix     String
  keyHash    String    @unique @map("key_hash")
  scopes     String[]
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ───────────────────────── Content graph ─────────────────────────

enum PublishStatus {
  draft
  review
  approved
  rejected
  published
  archived
}

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?

  shows Show[]

  @@map("categories")
}

model Topic {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  episodes EpisodeTopic[]

  @@map("topics")
}

model Show {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  tagline     String?
  description String?
  coverUrl    String?       @map("cover_url")
  bannerUrl   String?       @map("banner_url")
  categoryId  String?       @map("category_id")
  status      PublishStatus @default(draft)
  isDemo      Boolean       @default(false) @map("is_demo")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // ── Podcast distribution (§11): StockTank owns the feed; Castopod is an optional host ──
  /// Publishes /api/v1/podcasts/<slug>/feed.xml when the show is also published.
  podcastEnabled     Boolean @default(false) @map("podcast_enabled")
  podcastAuthor      String? @map("podcast_author")
  /// Apple Podcasts category and optional subcategory, e.g. Business / Investing.
  podcastCategory    String? @map("podcast_category")
  podcastSubcategory String? @map("podcast_subcategory")
  podcastExplicit    Boolean @default(false) @map("podcast_explicit")
  podcastLanguage    String  @default("en") @map("podcast_language")
  /// Castopod podcast this show syncs episodes to (created in Castopod; its REST API cannot create podcasts).
  castopodPodcastId  Int?    @map("castopod_podcast_id")

  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  seasons     Season[]
  episodes    Episode[]
  hosts       ShowHost[]
  follows     Follow[]
  livestreams Livestream[]

  @@index([status])
  @@map("shows")
}

model Season {
  id        String   @id @default(cuid())
  showId    String   @map("show_id")
  number    Int
  title     String?
  createdAt DateTime @default(now()) @map("created_at")

  show     Show      @relation(fields: [showId], references: [id], onDelete: Cascade)
  episodes Episode[]

  @@unique([showId, number])
  @@map("seasons")
}

model Episode {
  id              String        @id @default(cuid())
  showId          String        @map("show_id")
  seasonId        String?       @map("season_id")
  slug            String
  number          Int?
  title           String
  summary         String?
  description     String?
  coverUrl        String?       @map("cover_url")
  durationSeconds Int?          @map("duration_seconds")
  status          PublishStatus @default(draft)
  publishedAt     DateTime?     @map("published_at")
  isDemo          Boolean       @default(false) @map("is_demo")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  show              Show               @relation(fields: [showId], references: [id], onDelete: Cascade)
  season            Season?            @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  hosts             EpisodeHost[]
  guests            EpisodeGuest[]
  projects          EpisodeProject[]
  companies         EpisodeCompany[]
  topics            EpisodeTopic[]
  clips             Clip[]
  bookmarks         Bookmark[]
  /// The asset whose renditions play for this episode (set when processing succeeds).
  mediaAssetId      String?            @unique @map("media_asset_id")
  episodeType       PodcastEpisodeType @default(full) @map("episode_type")
  /// Castopod episode created from this episode, if synced.
  castopodEpisodeId Int?               @map("castopod_episode_id")
  podcastSyncStatus PodcastSyncStatus? @map("podcast_sync_status")
  podcastSyncError  String?            @map("podcast_sync_error")
  podcastSyncedAt   DateTime?          @map("podcast_synced_at")
  mediaAsset        MediaAsset?        @relation("EpisodeMedia", fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@unique([showId, slug])
  @@index([status, publishedAt])
  @@map("episodes")
}

model Host {
  id        String   @id @default(cuid())
  userId    String?  @unique @map("user_id")
  slug      String   @unique
  name      String
  bio       String?
  avatarUrl String?  @map("avatar_url")
  twitter   String?
  /// AI hosts must be disclosed (§25).
  isAi      Boolean  @default(false) @map("is_ai")
  isDemo    Boolean  @default(false) @map("is_demo")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  shows    ShowHost[]
  episodes EpisodeHost[]

  @@map("hosts")
}

model Guest {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  title     String?
  bio       String?
  avatarUrl String?  @map("avatar_url")
  twitter   String?
  website   String?
  isDemo    Boolean  @default(false) @map("is_demo")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  episodes EpisodeGuest[]

  @@map("guests")
}

model ShowHost {
  showId String @map("show_id")
  hostId String @map("host_id")

  show Show @relation(fields: [showId], references: [id], onDelete: Cascade)
  host Host @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@id([showId, hostId])
  @@map("show_hosts")
}

model EpisodeHost {
  episodeId String @map("episode_id")
  hostId    String @map("host_id")

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  host    Host    @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@id([episodeId, hostId])
  @@map("episode_hosts")
}

model EpisodeGuest {
  episodeId String  @map("episode_id")
  guestId   String  @map("guest_id")
  role      String?

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  guest   Guest   @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@id([episodeId, guestId])
  @@map("episode_guests")
}

model Chain {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  /// EVM chain id where applicable.
  chainId   Int?     @unique @map("chain_id")
  explorer  String?
  createdAt DateTime @default(now()) @map("created_at")

  projects  Project[]
  contracts Contract[]

  @@map("chains")
}

enum ProjectKind {
  crypto_project
  protocol
  dao
  infrastructure
  rwa
  ecosystem
  application
  traditional_company
}

model Project {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  /// Not every project has a token.
  symbol          String?
  kind            ProjectKind   @default(crypto_project)
  description     String?
  logoUrl         String?       @map("logo_url")
  bannerUrl       String?       @map("banner_url")
  website         String?
  twitter         String?
  discord         String?
  telegram        String?
  chainId         String?       @map("chain_id")
  contractAddress String?       @map("contract_address")
  category        String?
  status          PublishStatus @default(draft)
  launchDate      DateTime?     @map("launch_date")
  /// Market fields are informational provider snapshots, never advice.
  marketCap       Decimal?      @map("market_cap") @db.Decimal(24, 2)
  volume          Decimal?      @db.Decimal(24, 2)
  liquidity       Decimal?      @db.Decimal(24, 2)
  marketDataAt    DateTime?     @map("market_data_at")
  verified        Boolean       @default(false)
  isDemo          Boolean       @default(false) @map("is_demo")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  chain     Chain?           @relation(fields: [chainId], references: [id], onDelete: SetNull)
  contracts Contract[]
  episodes  EpisodeProject[]
  follows   Follow[]

  @@index([status])
  @@map("projects")
}

model Contract {
  id        String   @id @default(cuid())
  projectId String?  @map("project_id")
  chainId   String   @map("chain_id")
  address   String
  label     String?
  createdAt DateTime @default(now()) @map("created_at")

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  chain   Chain    @relation(fields: [chainId], references: [id], onDelete: Cascade)

  @@unique([chainId, address])
  @@map("contracts")
}

model Company {
  id                 String        @id @default(cuid())
  name               String
  slug               String        @unique
  ticker             String?
  exchange           String?
  sector             String?
  industry           String?
  description        String?
  logoUrl            String?       @map("logo_url")
  website            String?
  country            String?
  marketDataProvider String?       @map("market_data_provider")
  status             PublishStatus @default(draft)
  isDemo             Boolean       @default(false) @map("is_demo")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  episodes EpisodeCompany[]
  follows  Follow[]

  @@unique([exchange, ticker])
  @@map("companies")
}

model EpisodeProject {
  episodeId String @map("episode_id")
  projectId String @map("project_id")

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([episodeId, projectId])
  @@map("episode_projects")
}

model EpisodeCompany {
  episodeId String @map("episode_id")
  companyId String @map("company_id")

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([episodeId, companyId])
  @@map("episode_companies")
}

model EpisodeTopic {
  episodeId String @map("episode_id")
  topicId   String @map("topic_id")

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([episodeId, topicId])
  @@map("episode_topics")
}

/// Clips always link back to a source timestamp (§14). Public publication requires review.
model Clip {
  id              String        @id @default(cuid())
  sourceEpisodeId String        @map("source_episode_id")
  title           String
  startTime       Float         @map("start_time")
  endTime         Float         @map("end_time")
  transcript      String?
  confidence      Float?
  generationModel String?       @map("generation_model")
  reviewStatus    PublishStatus @default(draft) @map("review_status")
  /// Rendered outputs: { horizontal, vertical, square, thumbnail } object keys.
  renditions      Json?
  renderStatus    MediaStatus?  @map("render_status")
  renderError     String?       @map("render_error")
  isDemo          Boolean       @default(false) @map("is_demo")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  sourceEpisode Episode @relation(fields: [sourceEpisodeId], references: [id], onDelete: Cascade)

  @@index([reviewStatus])
  @@map("clips")
}

model NewsSource {
  id        String   @id @default(cuid())
  name      String
  url       String   @unique
  approved  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  articles Article[]

  @@map("news_sources")
}

model Article {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  summary     String?
  body        String?
  author      String?
  originalUrl String?       @map("original_url")
  sourceId    String?       @map("source_id")
  status      PublishStatus @default(draft)
  publishedAt DateTime?     @map("published_at")
  isDemo      Boolean       @default(false) @map("is_demo")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  source NewsSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@map("articles")
}

// ───────────────────────── Engagement ─────────────────────────

/// Polymorphic follow: exactly one target column is set (enforced in the API layer).
model Follow {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  showId    String?  @map("show_id")
  projectId String?  @map("project_id")
  companyId String?  @map("company_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  show    Show?    @relation(fields: [showId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, showId])
  @@unique([userId, projectId])
  @@unique([userId, companyId])
  @@map("follows")
}

model Bookmark {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  episodeId       String   @map("episode_id")
  positionSeconds Int      @default(0) @map("position_seconds")
  createdAt       DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@map("bookmarks")
}

// ───────────────────────── Live schedule (§12, before AzuraCast) ─────────────────────────

enum LivestreamStatus {
  scheduled
  live
  ended
  cancelled
}

model Livestream {
  id             String           @id @default(cuid())
  showId         String?          @map("show_id")
  title          String
  description    String?
  status         LivestreamStatus @default(scheduled)
  scheduledStart DateTime         @map("scheduled_start")
  scheduledEnd   DateTime?        @map("scheduled_end")
  startedAt      DateTime?        @map("started_at")
  endedAt        DateTime?        @map("ended_at")
  /// HLS or station stream URL once media infrastructure exists (Milestones 3–5).
  streamUrl      String?          @map("stream_url")
  isDemo         Boolean          @default(false) @map("is_demo")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  show     Show?               @relation(fields: [showId], references: [id], onDelete: SetNull)
  segments LivestreamSegment[]

  @@index([status, scheduledStart])
  @@map("livestreams")
}

model LivestreamSegment {
  id           String @id @default(cuid())
  livestreamId String @map("livestream_id")
  position     Int
  title        String

  livestream Livestream @relation(fields: [livestreamId], references: [id], onDelete: Cascade)

  @@unique([livestreamId, position])
  @@map("livestream_segments")
}

// ───────────────────────── Advertising (§34, §56) ─────────────────────────

enum AdvertiserStatus {
  pending_review
  approved
  suspended
}

enum PlacementSurface {
  web
  newsletter
  audio
  video
}

enum PlacementFormat {
  sponsor_banner
  native_card
  leaderboard
  sidebar_card
  audio_read
  video_preroll
  show_sponsorship
  newsletter_slot
}

enum PricingModel {
  cpm
  flat_week
  flat_episode
  flat_issue
}

enum RateVisibility {
  public
  on_request
}

enum CampaignStatus {
  draft
  in_review
  approved
  rejected
  paused
  completed
}

enum CreativeKind {
  display
  native
  audio_script
  video
}

model Advertiser {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  website         String?
  contactName     String?          @map("contact_name")
  contactEmail    String?          @map("contact_email")
  industry        String?
  status          AdvertiserStatus @default(pending_review)
  /// Internal compliance notes (KYC, category checks). Never shown publicly.
  complianceNotes String?          @map("compliance_notes")
  isHouse         Boolean          @default(false) @map("is_house")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  campaigns Campaign[]
  inquiries AdvertisingInquiry[]

  @@map("advertisers")
}

/// Sellable inventory. Rates are set by sales in the admin; nothing is priced by default.
model AdPlacement {
  id                 String           @id @default(cuid())
  key                String           @unique
  name               String
  description        String
  surface            PlacementSurface
  format             PlacementFormat
  specs              String
  pricingModel       PricingModel     @map("pricing_model")
  rateCents          Int?             @map("rate_cents")
  currency           String           @default("USD")
  rateVisibility     RateVisibility   @default(on_request) @map("rate_visibility")
  maxActiveCampaigns Int              @default(1) @map("max_active_campaigns")
  isActive           Boolean          @default(true) @map("is_active")
  sortOrder          Int              @default(0) @map("sort_order")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  campaigns   CampaignPlacement[]
  impressions AdImpression[]
  clicks      AdClick[]

  @@map("ad_placements")
}

model Campaign {
  id                 String         @id @default(cuid())
  advertiserId       String         @map("advertiser_id")
  name               String
  objective          String?
  status             CampaignStatus @default(draft)
  startsAt           DateTime       @map("starts_at")
  endsAt             DateTime       @map("ends_at")
  pricingModel       PricingModel   @map("pricing_model")
  rateCents          Int            @map("rate_cents")
  budgetCents        Int            @map("budget_cents")
  currency           String         @default("USD")
  impressionGoal     Int?           @map("impression_goal")
  /// Max impressions per visitor per day (null = uncapped).
  frequencyCapPerDay Int?           @map("frequency_cap_per_day")
  weight             Int            @default(1)
  createdById        String?        @map("created_by_id")
  submittedAt        DateTime?      @map("submitted_at")
  reviewedById       String?        @map("reviewed_by_id")
  reviewedAt         DateTime?      @map("reviewed_at")
  rejectionReason    String?        @map("rejection_reason")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  advertiser  Advertiser          @relation(fields: [advertiserId], references: [id], onDelete: Restrict)
  placements  CampaignPlacement[]
  creatives   CreativeAsset[]
  impressions AdImpression[]
  clicks      AdClick[]

  @@index([status, startsAt, endsAt])
  @@index([advertiserId])
  @@map("campaigns")
}

model CampaignPlacement {
  campaignId  String @map("campaign_id")
  placementId String @map("placement_id")

  campaign  Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  placement AdPlacement @relation(fields: [placementId], references: [id], onDelete: Restrict)

  @@id([campaignId, placementId])
  @@map("campaign_placements")
}

model CreativeAsset {
  id              String        @id @default(cuid())
  campaignId      String        @map("campaign_id")
  kind            CreativeKind
  headline        String
  body            String?
  imageUrl        String?       @map("image_url")
  altText         String?       @map("alt_text")
  ctaLabel        String        @default("Learn more") @map("cta_label")
  /// Validated http(s) destination. Clicks redirect only to this stored URL.
  clickUrl        String        @map("click_url")
  disclosureLabel String        @default("Sponsored") @map("disclosure_label")
  reviewStatus    PublishStatus @default(draft) @map("review_status")
  /// Automated policy findings (e.g. guaranteed-return language). Reviewers must acknowledge them.
  policyFlags     String[]      @map("policy_flags")
  reviewNotes     String?       @map("review_notes")
  reviewedById    String?       @map("reviewed_by_id")
  reviewedAt      DateTime?     @map("reviewed_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  campaign    Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  impressions AdImpression[]
  clicks      AdClick[]

  @@index([campaignId, reviewStatus])
  @@map("creative_assets")
}

/// One row per verified impression token; the token id makes recording idempotent.
model AdImpression {
  id          String   @id
  campaignId  String   @map("campaign_id")
  creativeId  String   @map("creative_id")
  placementId String   @map("placement_id")
  /// SHA-256 of the anonymous visitor id, never the raw cookie value.
  visitorHash String?  @map("visitor_hash")
  userId      String?  @map("user_id")
  pagePath    String?  @map("page_path")
  createdAt   DateTime @default(now()) @map("created_at")

  campaign  Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creative  CreativeAsset @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  placement AdPlacement   @relation(fields: [placementId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([placementId, createdAt])
  @@map("ad_impressions")
}

model AdClick {
  id           String   @id @default(cuid())
  impressionId String?  @map("impression_id")
  campaignId   String   @map("campaign_id")
  creativeId   String   @map("creative_id")
  placementId  String   @map("placement_id")
  visitorHash  String?  @map("visitor_hash")
  userId       String?  @map("user_id")
  createdAt    DateTime @default(now()) @map("created_at")

  campaign  Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creative  CreativeAsset @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  placement AdPlacement   @relation(fields: [placementId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@map("ad_clicks")
}

// ───────────────────────── Marketing & sales pipeline ─────────────────────────

enum InquiryStatus {
  new
  contacted
  qualified
  proposal_sent
  won
  lost
  spam
}

enum BudgetRange {
  under_5k
  from_5k_to_25k
  from_25k_to_100k
  over_100k
  undisclosed
}

model AdvertisingInquiry {
  id            String        @id @default(cuid())
  company       String
  contactName   String        @map("contact_name")
  email         String
  website       String?
  budgetRange   BudgetRange   @map("budget_range")
  placementKeys String[]      @map("placement_keys")
  message       String
  status        InquiryStatus @default(new)
  notes         String?
  advertiserId  String?       @map("advertiser_id")
  assignedToId  String?       @map("assigned_to_id")
  utmSource     String?       @map("utm_source")
  utmMedium     String?       @map("utm_medium")
  utmCampaign   String?       @map("utm_campaign")
  referrer      String?
  ipHash        String?       @map("ip_hash")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  advertiser Advertiser? @relation(fields: [advertiserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("advertising_inquiries")
}

enum SubscriberStatus {
  pending
  confirmed
  unsubscribed
}

/// Newsletter audience with double opt-in. Tokens are stored hashed.
model NewsletterSubscriber {
  id                   String           @id @default(cuid())
  email                String           @unique
  status               SubscriberStatus @default(pending)
  source               String?
  utmSource            String?          @map("utm_source")
  utmMedium            String?          @map("utm_medium")
  utmCampaign          String?          @map("utm_campaign")
  consentAt            DateTime         @map("consent_at")
  confirmTokenHash     String?          @unique @map("confirm_token_hash")
  confirmSentAt        DateTime?        @map("confirm_sent_at")
  confirmedAt          DateTime?        @map("confirmed_at")
  unsubscribeTokenHash String           @unique @map("unsubscribe_token_hash")
  unsubscribedAt       DateTime?        @map("unsubscribed_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  @@index([status])
  @@map("newsletter_subscribers")
}

// ───────── Live radio (§12) ─────────

/// A StockTank radio station. Playback and now-playing come from AzuraCast; StockTank owns the listing and UI.
model RadioStation {
  id                 String        @id @default(cuid())
  slug               String        @unique
  name               String
  description        String?
  /// AzuraCast station shortcode (e.g. stocktank_radio). The API resolves stream URLs and now playing from it.
  azuracastShortcode String        @unique @map("azuracast_shortcode")
  status             PublishStatus @default(draft)
  sortOrder          Int           @default(0) @map("sort_order")
  isDemo             Boolean       @default(false) @map("is_demo")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  @@index([status, sortOrder])
  @@map("radio_stations")
}

// ───────── Podcast distribution (§11) ─────────

enum PodcastEpisodeType {
  full
  trailer
  bonus
}

enum PodcastSyncStatus {
  queued
  syncing
  synced
  failed
}

// ───────── Media pipeline (§13) ─────────

enum MediaKind {
  video
  audio
}

enum MediaStatus {
  pending_upload
  uploaded
  processing
  ready
  failed
}

/// An uploaded original and everything rendered from it. Originals are private; renditions are served via the CDN.
model MediaAsset {
  id                  String      @id @default(cuid())
  kind                MediaKind
  status              MediaStatus @default(pending_upload)
  originalKey         String      @unique @map("original_key")
  originalName        String      @map("original_name")
  mimeType            String      @map("mime_type")
  /// Size declared by the uploader; verified against object storage on completion.
  sizeBytes           BigInt      @map("size_bytes")
  durationSeconds     Float?      @map("duration_seconds")
  width               Int?
  height              Int?
  /// { hls, audio, poster, variants: [{ name, height, bandwidth }] } object keys.
  renditions          Json?
  error               String?
  progress            Int         @default(0)
  attempts            Int         @default(0)
  createdById         String?     @map("created_by_id")
  /// Episode that switches to this asset once it is ready, so a replacement never interrupts current playback.
  targetEpisodeId     String?     @map("target_episode_id")
  processingStartedAt DateTime?   @map("processing_started_at")
  readyAt             DateTime?   @map("ready_at")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  episode Episode? @relation("EpisodeMedia")

  @@index([status, createdAt])
  @@index([targetEpisodeId])
  @@map("media_assets")
}
