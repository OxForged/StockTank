# Copy to .env — docker compose reads this file.
# Postgres (the Docker path):
DATABASE_URL=postgresql+psycopg://metarealm:metarealm_dev@db:5432/metarealm_os
# Quick no-Docker run instead:  DATABASE_URL=sqlite:///./dev.db

CORS_ORIGINS=["http://localhost:3000"]
AUTO_SEED=true

# Reserved for later milestones (M6+):
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct
EMBED_MODEL=nomic-embed-text
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
TIMEZONE=Africa/Casablanca
# Employees that use the paid Claude API when ANTHROPIC_API_KEY is set:
PREMIUM_AGENTS=
SEARXNG_URL=http://searxng:8080
