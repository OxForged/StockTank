# Builder API key from build.hellominds.ai (Profile -> API key).
MINDS_BUILDER_API_KEY=

# The Mind the examples talk to. `npm run -s example:hello` prints the ids your
# key can reach if you leave this blank.
MIND_ID=

# Only needed by examples/circle.mjs, which chains three Minds.
SCOUT_MIND_ID=
ORACLE_MIND_ID=
OPERATOR_MIND_ID=
