{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "generate": { "cache": false },
    "build": { "dependsOn": ["^build", "generate"], "outputs": ["dist/**"] },
    "typecheck": { "dependsOn": ["^build", "generate"] },
    "lint": { "dependsOn": ["^build", "generate"] },
    "test": { "dependsOn": ["^build", "generate"], "env": ["DATABASE_URL", "TEST_DATABASE_URL", "REDIS_URL"] },
    "dev": { "cache": false, "persistent": true, "dependsOn": ["^build", "generate"] }
  }
}
