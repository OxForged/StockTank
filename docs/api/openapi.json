{
  "openapi": "3.1.0",
  "info": {
    "title": "StockTank API",
    "version": "0.1.0",
    "description": "Identity, RBAC and system endpoints for StockTank. Sessions are cookie-based; state-changing requests must send `X-Requested-With`. Financial content served by this platform is informational only and never investment advice."
  },
  "servers": [
    {
      "url": "/",
      "description": "Same origin (dev proxy or deployed API host)"
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "Health, readiness and version"
    },
    {
      "name": "Auth",
      "description": "Registration, login and session"
    },
    {
      "name": "Admin",
      "description": "User administration (permission-gated)"
    }
  ],
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "st_session",
        "description": "httpOnly session cookie set by /api/v1/auth/register and /api/v1/auth/login. The server stores only a SHA-256 hash of the token."
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ],
        "example": {
          "status": "ok"
        }
      },
      "ReadyResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "not_ready"
            ]
          },
          "checks": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "ok": {
                  "type": "boolean"
                },
                "latencyMs": {
                  "type": "number"
                },
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "ok"
              ]
            }
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "example": {
          "status": "ready",
          "checks": {
            "postgres": {
              "ok": true,
              "latencyMs": 1.4
            },
            "redis": {
              "ok": true,
              "latencyMs": 0.6
            }
          }
        }
      },
      "VersionResponse": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "stocktank-api"
            ]
          },
          "version": {
            "type": "string"
          },
          "commit": {
            "type": [
              "string",
              "null"
            ]
          },
          "node": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "commit",
          "node"
        ],
        "example": {
          "name": "stocktank-api",
          "version": "0.1.0",
          "commit": "3f2a9c1",
          "node": "v24.0.0"
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/CurrentUser"
          }
        },
        "required": [
          "user"
        ],
        "example": {
          "user": {
            "id": "cmfk1q2w30000v8l3d9e7a1b2",
            "email": "ada@example.com",
            "displayName": "Ada Lovelace",
            "avatarUrl": null,
            "roles": [
              "viewer"
            ],
            "permissions": [],
            "createdAt": "2026-09-16T12:00:00.000Z"
          }
        }
      },
      "CurrentUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "avatarUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "super_admin",
                "admin",
                "editor",
                "creator",
                "viewer"
              ]
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "users.read",
                "users.manage",
                "roles.manage",
                "content.read_drafts",
                "content.write",
                "content.publish",
                "entities.write",
                "ai.review",
                "distribution.publish",
                "ads.manage",
                "feature_flags.manage",
                "audit_logs.read",
                "api_keys.manage",
                "settings.manage"
              ]
            }
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "avatarUrl",
          "roles",
          "permissions",
          "createdAt"
        ],
        "example": {
          "id": "cmfk1q2w30000v8l3d9e7a1b2",
          "email": "ada@example.com",
          "displayName": "Ada Lovelace",
          "avatarUrl": null,
          "roles": [
            "viewer"
          ],
          "permissions": [],
          "createdAt": "2026-09-16T12:00:00.000Z"
        }
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "BAD_REQUEST",
                  "VALIDATION_FAILED",
                  "UNAUTHENTICATED",
                  "FORBIDDEN",
                  "NOT_FOUND",
                  "CONFLICT",
                  "RATE_LIMITED",
                  "INTERNAL"
                ]
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              },
              "details": {}
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ],
        "description": "Envelope used by every non-2xx response.",
        "example": {
          "error": {
            "code": "VALIDATION_FAILED",
            "message": "Invalid request body",
            "requestId": "7f1c1b7e-2d1a-4a4d-9d2b-3b7b2a1f0c9e",
            "details": {
              "source": "body",
              "issues": [
                {
                  "path": "email",
                  "message": "Invalid email address",
                  "code": "invalid_format"
                }
              ]
            }
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          },
          "displayName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          }
        },
        "required": [
          "email",
          "password",
          "displayName"
        ],
        "example": {
          "email": "ada@example.com",
          "password": "correct horse battery staple",
          "displayName": "Ada Lovelace"
        }
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ],
        "example": {
          "email": "ada@example.com",
          "password": "correct horse battery staple"
        }
      },
      "AdminUserListResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminUser"
            }
          },
          "page": {
            "type": "number"
          },
          "pageSize": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        },
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ]
      },
      "AdminUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "suspended"
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "super_admin",
                "admin",
                "editor",
                "creator",
                "viewer"
              ]
            }
          },
          "createdAt": {
            "type": "string"
          },
          "lastLoginAt": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "status",
          "roles",
          "createdAt",
          "lastLoginAt"
        ],
        "example": {
          "id": "cmfk1q2w30000v8l3d9e7a1b2",
          "email": "ada@example.com",
          "displayName": "Ada Lovelace",
          "status": "active",
          "roles": [
            "viewer"
          ],
          "createdAt": "2026-09-16T12:00:00.000Z",
          "lastLoginAt": "2026-09-16T13:30:00.000Z"
        }
      },
      "UpdateUserRolesRequest": {
        "type": "object",
        "properties": {
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "super_admin",
                "admin",
                "editor",
                "creator",
                "viewer"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "roles"
        ],
        "example": {
          "roles": [
            "viewer",
            "editor"
          ]
        }
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Liveness probe",
        "description": "Always 200 while the process can serve requests. No dependencies are checked.",
        "responses": {
          "200": {
            "description": "The API process is alive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Readiness probe",
        "description": "Checks Postgres (SELECT 1) and, when configured, Redis (PING), reporting per-check latency.",
        "responses": {
          "200": {
            "description": "All dependencies reachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          },
          "503": {
            "description": "At least one dependency failed its check",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/version": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Build information",
        "responses": {
          "200": {
            "description": "Version, git commit (null when unknown) and Node runtime",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "This OpenAPI document",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": {}
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Create an account",
        "description": "Creates a user with the `viewer` role, starts a session and sets the `st_session` cookie. Passwords are hashed with argon2id.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "CSRF guard required on every state-changing request under /api. Any non-empty value (the official clients send \"stocktank\").",
              "example": "stocktank"
            },
            "required": true,
            "description": "CSRF guard required on every state-changing request under /api. Any non-empty value (the official clients send \"stocktank\").",
            "name": "x-requested-with",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created; session cookie set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed or invalid input (BAD_REQUEST / VALIDATION_FAILED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Missing X-Requested-With header or disallowed Origin (FORBIDDEN)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "An account with this email already exists (CONFLICT)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded (RATE_LIMITED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error (INTERNAL)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Sign in",
        "description": "Verifies credentials and starts a new session (any session cookie sent with the request is revoked). Failures are deliberately indistinguishable between unknown email and wrong password. Limited to 10 failed attempts per 15 minutes per IP and email.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "CSRF guard required on every state-changing request under /api. Any non-empty value (the official clients send \"stocktank\").",
              "example": "stocktank"
            },
            "required": true,
            "description": "CSRF guard required on every state-changing request under /api. Any non-empty value (the official clients send \"stocktank\").",
            "name": "x-requested-with",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in; session cookie set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed or invalid input (BAD_REQUEST / VALIDATION_FAILED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Invalid email or password (UNAUTHENTICATED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Account suspended, missing X-Requested-With, or disallowed Origin (FORBIDDEN)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded (RATE_LIMITED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error (INTERNAL)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Sign out",
        "description": "Revokes the current session and clears the cookie.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "CSRF guard required on every state-changing request under /api. Any non-empty value (the official clients send \"stocktank\").",
              "example": "stocktank"
            },
            "required": true,
            "description": "CSRF guard required on every state-changing request under /api. Any non-empty value (the official clients send \"stocktank\").",
            "name": "x-requested-with",
            "in": "header"
          }
        ],
        "responses": {
          "204": {
            "description": "Session revoked; cookie cleared"
          },
          "401": {
            "description": "No valid session cookie (UNAUTHENTICATED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Missing X-Requested-With / disallowed Origin, or insufficient permission (FORBIDDEN)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded (RATE_LIMITED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error (INTERNAL)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Current user",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The signed-in user with resolved roles and permissions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "description": "No valid session cookie (UNAUTHENTICATED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded (RATE_LIMITED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error (INTERNAL)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/users": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "List users",
        "description": "Requires the `users.read` permission.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "required": false,
            "name": "page",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            },
            "required": false,
            "name": "pageSize",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of users, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed or invalid input (BAD_REQUEST / VALIDATION_FAILED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "No valid session cookie (UNAUTHENTICATED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Missing X-Requested-With / disallowed Origin, or insufficient permission (FORBIDDEN)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded (RATE_LIMITED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error (INTERNAL)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/users/{id}/roles": {
      "put": {
        "tags": [
          "Admin"
        ],
        "summary": "Replace a user’s roles",
        "description": "Requires `users.manage`. Granting or revoking `super_admin` or `admin` additionally requires `roles.manage`. The last `super_admin` can never be removed. Every change is written to the audit log.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "CSRF guard required on every state-changing request under /api. Any non-empty value (the official clients send \"stocktank\").",
              "example": "stocktank"
            },
            "required": true,
            "description": "CSRF guard required on every state-changing request under /api. Any non-empty value (the official clients send \"stocktank\").",
            "name": "x-requested-with",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserRolesRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
