# ---- Core ----
NODE_ENV=development
APP_VERSION=0.1.0
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5190,http://localhost:5181
PUBLIC_WEB_URL=http://localhost:5190
PUBLIC_ADMIN_URL=http://localhost:5181

# ---- API ----
API_PORT=4000
# 32+ random bytes, e.g. `openssl rand -base64 48`
SESSION_SECRET=replace-with-long-random-string
SESSION_TTL_HOURS=336
# Express "trust proxy": false, true, a hop count, or e.g. loopback / 10.0.0.0/8 (set when behind a reverse proxy)
TRUST_PROXY=false
# pino level: fatal|error|warn|info|debug|trace|silent (defaults: info in production, debug otherwise)
LOG_LEVEL=
# Reported by GET /version (set by CI / the Docker build)
GIT_COMMIT=

# ---- Database / cache ----
DATABASE_URL=postgresql://stocktank:stocktank_dev@localhost:5432/stocktank
TEST_DATABASE_URL=postgresql://stocktank:stocktank_dev@localhost:5432/stocktank_test
REDIS_URL=redis://localhost:6379

# ---- Search ----
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=stocktank_dev_master_key

# ---- Object storage (S3-compatible; MinIO in dev) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=stocktank-media
S3_ACCESS_KEY=stocktank
S3_SECRET_KEY=stocktank_dev_secret
# Public base for renditions (CDN in production). Originals stay private.
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/stocktank-media
MEDIA_MAX_UPLOAD_MB=4096
# Media worker concurrency (FFmpeg is CPU heavy)
MEDIA_WORKER_CONCURRENCY=1

# ---- Podcast / Live ----
CASTOPOD_URL=
# Castopod REST API v1 (restapi.enabled=true, restapi.basicAuth=true). Optional.
CASTOPOD_API_USERNAME=
CASTOPOD_API_PASSWORD=
# Castopod user id recorded as the creator of synced episodes
CASTOPOD_USER_ID=
# Shown as itunes:owner in podcast feeds
PODCAST_OWNER_NAME=StockTank
PODCAST_OWNER_EMAIL=
# AzuraCast: URL enables now playing and streams; the API key (Bearer) adds station health and playlists.
AZURACAST_URL=
AZURACAST_API_KEY=

# ---- AI providers ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Text generation vendor: anthropic (default when its key is set) or openai
AI_LLM_PROVIDER=
AI_LLM_MODEL=
AI_FAST_MODEL=
# Embeddings and transcription currently use OpenAI (text-embedding-3-small at 1024 dims, whisper-1)
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_TRANSCRIPTION_MODEL=whisper-1
# JSON price overrides, e.g. {"claude-sonnet-5":{"inputPerMTok":3,"outputPerMTok":15}}. Unpriced models record unknown cost.
AI_MODEL_PRICING=

# ---- Analytics / errors ----
POSTHOG_KEY=
POSTHOG_HOST=
SENTRY_DSN=

# ---- Social ----
X_CLIENT_ID=
X_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ---- Email / push ----
# resend | log (development only: prints emails to the API log) | none
EMAIL_PROVIDER=log
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
# Optional: new advertising inquiries are emailed here
SALES_NOTIFY_EMAIL=
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=

# ---- First admin (used once by `pnpm db:seed`; leave blank to skip) ----
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Local-only one-click staff sign-in (refused when NODE_ENV=production)
DEV_LOGIN_ENABLED=false
MEILISEARCH_INDEX_PREFIX=stocktank
