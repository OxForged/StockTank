{
  "name": "@stocktank/media-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env --import tsx src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/worker.js",
    "bucket": "node --env-file-if-exists=../../.env --import tsx src/ensure-bucket.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@stocktank/database": "workspace:*",
    "@stocktank/media": "workspace:*",
    "bullmq": "^6.3.6",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.23.13",
    "vitest": "^5.0.1"
  }
}
